# Copy the relevant block to apps/<app>/.env (read by both Next.js and the Prisma CLI). Never commit real values.

# --- apps/dashboard ---
# Neon: pooled connection string. Local: the docker-compose database.
DATABASE_URL="postgresql://devlens:devlens@localhost:5432/devlens"
# Neon: direct (non-pooled) connection string, used by `prisma migrate`.
DIRECT_URL="postgresql://devlens:devlens@localhost:5432/devlens"
# Dashboard tests only. Must end in "_test": the tests wipe every table.
TEST_DATABASE_URL="postgresql://devlens:devlens@localhost:5432/devlens_test"
# Auth.js session signing secret. Generate one with: npx auth secret
AUTH_SECRET=""
# Password for the seeded demo@devlens.test user (prisma/seed.ts).
SEED_PASSWORD=""

# --- apps/demo-app ---
DATABASE_URL="postgresql://devlens:devlens@localhost:5432/demo"
DIRECT_URL="postgresql://devlens:devlens@localhost:5432/demo"
# Dashboard ingest endpoint the SDKs send spans to.
NEXT_PUBLIC_DEVLENS_ENDPOINT="http://localhost:3000/api/ingest"
# Public key (pk_...) - safe in the browser, browser spans only.
NEXT_PUBLIC_DEVLENS_KEY=""
# Secret key (sk_...) - server only, shown once when the project is created.
DEVLENS_SECRET_KEY=""
# Set automatically by Render on deploy; enables GitHub source links. Leave unset locally.
RENDER_GIT_COMMIT=""

# --- both apps, when deployed ---
NODE_OPTIONS="--enable-source-maps"
